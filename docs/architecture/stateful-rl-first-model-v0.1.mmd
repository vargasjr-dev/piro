%% Piro Core Self-Updating Model v0.2
%% Fast/slow weights are core; CTM is a deferred comparison architecture.
flowchart LR
    classDef core fill:#dcecff,stroke:#28639b,color:#10243a,stroke-width:1.5px
    classDef learning fill:#ffe4c7,stroke:#a85b00,color:#4d2900,stroke-width:1.5px
    classDef external fill:#f2ddff,stroke:#7a3f9b,color:#32153f,stroke-width:1.5px
    classDef durable fill:#d9f2d9,stroke:#287a3d,color:#102515,stroke-width:1.5px
    classDef deferred fill:#eeeeee,stroke:#777777,color:#333333,stroke-width:1.5px,stroke-dasharray: 5 5

    X[User / tools / environment]:::external --> I[Observation]:::external
    I --> E[Embed]:::core
    W[Durable weights]:::durable --> B[BindFastState]:::core
    F[Fast state value]:::learning --> B
    E --> P[PredictNextToken]:::core
    B --> P
    P --> A[FastAdaptation]:::learning
    I --> A
    A --> F
    F --> B
    B --> O[OutputHead]:::core
    O --> Y[Output]:::external
    F --> C[ConsolidateWeights]:::learning
    C --> W
    C --> M[SaveWeights]:::durable

    T[Deferred CTM experiment]:::deferred -.->|must beat baseline on a named capability| B
