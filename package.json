{
  "name": "piro",
  "description": "Train your own tiny, RL-first model — built to grow, not decay.",
  "version": "0.0.1",
  "license": "MIT",
  "repository": "vargasjr-dev/piro",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"**/*.tsx\"",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:studio": "drizzle-kit studio",
    "bench": "uv run python model/run_benchmarks.py"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "@neondatabase/serverless": "^0.10.0",
    "@vercel/functions": "^1.4.1",
    "better-auth": "1.4.0",
    "drizzle-orm": "^0.41.0",
    "next": "^15.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "resend": "^6.10.0",
    "stripe": "^22.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.0.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^15.0.0",
    "prettier": "^3.0.0"
  }
}
