{
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "rules": {
    "no-restricted-syntax": [
      "error",
      {
        "selector": "TSAsExpression",
        "message": "Use Zod parsing instead of `as` casts."
      },
      {
        "selector": "TSTypeAssertion",
        "message": "Use Zod parsing instead of angle-bracket casts."
      }
    ]
  }
}
