# Direct Neon endpoint for neon-http (do not use a hostname containing -pooler.)
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=

# Mentor scoring — Anthropic API key for LLM-based reward evaluation
# Required to use the POST /api/mentors/[id]/score endpoint
ANTHROPIC_API_KEY=

# Object storage — user file system (Backblaze B2 default, any S3-compatible works)
# B2: Endpoint format is https://s3.{region}.backblazeb2.com (shown after bucket creation)
# B2: Access keys → App Keys → Add Application Key (restrict to piro-kb bucket, Read+Write)
BUCKET_ENDPOINT_URL=
BUCKET_KEY_ID=
BUCKET_APPLICATION_SECRET=

# Internal gateway-to-Modal authentication. Keep this server-side.
MODAL_WEBHOOK_SECRET=
MODAL_TRAINING_ENDPOINT=https://dvargasfuertes--piro-training-trigger.modal.run
MODAL_SOURCE_ENDPOINT=https://dvargasfuertes--piro-source-source.modal.run

# Temporary admin-only Hugging Face model migration token. Keep unset locally.
HF_MIGRATION_TOKEN=
