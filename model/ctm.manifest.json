{
  "name": "Continuous Thought Model",
  "slug": "ctm",
  "description": "Iterative tick-loop architecture with sync-driven attention. Neuron state accumulates across ticks before committing to an output \u2014 trades parameter efficiency for internal reasoning depth.",
  "hyperparams": {
    "n_neurons": 4,
    "embed_dim": 8,
    "query_dim": 8,
    "value_dim": 8,
    "hidden_dim": 16,
    "n_classes": 5,
    "max_ticks": 32,
    "confidence_threshold": 0.9
  },
  "parameterCount": 870,
  "module": "model.ctm",
  "modelClass": "ContinuousThoughtModel",
  "configClass": "CTMConfig",
  "graph": {
    "nodes": [
      { "id": "input",     "type": "io",         "label": "Input",           "detail": "4 \u00d7 8" },
      { "id": "sync_init", "type": "sync",        "label": "Sync Matrix",     "detail": "Pearson correlation \u00b7 4\u00d74" },
      {
        "id": "tick_loop",
        "type": "loop",
        "label": "Tick Loop",
        "detail": "max 32 ticks \u00b7 exits when confidence \u2265 0.9",
        "nodes": [
          { "id": "tl_attn", "type": "attention",  "label": "Sync Attention",  "detail": "query from sync \u00b7 K/V from context \u00b7 dim 8" },
          { "id": "tl_sync", "type": "sync",       "label": "Recompute Sync",  "detail": "Pearson correlation \u00b7 4\u00d74" },
          { "id": "tl_conf", "type": "confidence", "label": "Confidence Gate", "detail": "hidden 16 \u00b7 threshold 0.9" }
        ]
      },
      { "id": "out_head", "type": "linear", "label": "Output Head", "detail": "4\u00d74 sync \u2192 hidden 16 \u2192 5" },
      { "id": "output",   "type": "io",     "label": "Output",      "detail": "5 logits" }
    ],
    "edges": [
      { "from": "input",     "to": "sync_init" },
      { "from": "sync_init", "to": "tick_loop" },
      { "from": "tick_loop", "to": "out_head"  },
      { "from": "out_head",  "to": "output"    }
    ]
  }
}
